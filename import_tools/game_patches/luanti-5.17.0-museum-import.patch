+// Read one flat "array" argument (Lua table, 1-based) of n integers into out.
+static void readMapgenInputArray(lua_State *L, int arg, const char *name,
+	size_t n, std::vector<s32> *out)
+{
+	luaL_checktype(L, arg, LUA_TTABLE);
+	if (lua_objlen(L, arg) != n)
+		throw LuaError(std::string(name) + " must have exactly " +
+			std::to_string(n) + " entries");
+	out->resize(n);
+	for (size_t i = 0; i < n; i++) {
+		lua_rawgeti(L, arg, i + 1);
+		(*out)[i] = lua_tointeger(L, -1);
+		lua_pop(L, 1);
+	}
+}
+
+// generate_decorations_with_inputs(vm, p1, p2, heightmap, biomemap)
+//
+// Museum-import extension (PLAN-worldgen-merge.md): run the engine's own
+// decoration placement (DecorationManager::placeAllDecos -- trees, plants,
+// kelp, schematics, all Mineclonia-registered rules) over the p1..p2 area
+// exactly like Mapgen::makeChunk would, but with CALLER-supplied per-column
+// placement inputs instead of the live mapgen's maps:
+//
+//   heightmap  flat array of carea_size^2 heights, indexed
+//              carea_size * (z - p1.Z) + (x - p1.X) + 1: the y of the
+//              column's topmost walkable node. 32767 = skip the column.
+//   biomemap   flat array of carea_size^2 biome ids (core.get_biome_id),
+//              same indexing; each decoration is filtered per column
+//              against its registered biomes set.
+//
+// This exists so a mod that reshapes terrain AFTER mapgen ran (the museum
+// worldgen-merge gap fill) can still grow Mineclonia's natural vegetation
+// on the reshaped surface at the correct heights and for the correct
+// biomes -- the "correct inputs to hook into the natural worldgen".
+// Returns true; callers feature-detect this function by existence.
+int ModApiMapgen::l_generate_decorations_with_inputs(lua_State *L)
+{
+	NO_MAP_LOCK_REQUIRED;
+
+	auto *emerge = getEmergeManager(L);
+	if (!emerge || !emerge->mgparams)
+		return 0;
+
+	DecorationManager *decomgr;
+	Mapgen mg;
+	MMVManip *vm = checkObject<LuaVoxelManip>(L, 1)->vm;
+	if (auto mgc = getMapgen(L))
+		decomgr = mgc->m_emerge->decomgr;
+	else
+		decomgr = emerge->decomgr;
+	// Intentionally truncates to s32, see Mapgen::Mapgen()
+	mg.seed = (s32)emerge->mgparams->seed;
+	mg.ndef = emerge->ndef;
+
+	v3s16 pmin = check_v3s16(L, 2), pmax = check_v3s16(L, 3);
+	sortBoxVerticies(pmin, pmax);
+	const int carea_size = pmax.X - pmin.X + 1;
+	if (pmax.Z - pmin.Z + 1 != carea_size)
+		throw LuaError("generate_decorations_with_inputs requires a "
+			       "square area (XZ)");
+	const size_t n = (size_t)carea_size * carea_size;
+
+	std::vector<s32> heightmap, biomemap;
+	readMapgenInputArray(L, 4, "heightmap", n, &heightmap);
+	readMapgenInputArray(L, 5, "biomemap", n, &biomemap);
+
+	// Mapgen's own dtor does not free these (only MapgenBasic's does) and
+	// the vectors outlive the placement call below, so plain pointer
+	// assignment is correct here.
+	std::vector<s16> heights(n);
+	std::vector<biome_t> biomes(n);
+	for (size_t i = 0; i < n; i++) {
+		heights[i] = (s16)heightmap[i];
+		biomes[i] = (biome_t)biomemap[i];
+	}
+	mg.heightmap = heights.data();
+	mg.biomemap = biomes.data();
+
+	u32 blockseed = Mapgen::getBlockSeed(pmin, mg.seed);
+
+	mg.vm = vm;
+	decomgr->placeAllDecos(&mg, blockseed, pmin, pmax);
+	mg.vm = nullptr;
+
+	lua_pushboolean(L, true);
+	return 1;
+}
+
