+// [CUSTOM] send_interact(action, pointed_thing)
+// Sends a real TOSERVER_INTERACT packet for a constructed PointedThing.
+// This is the client-side equivalent of a player right-clicking / left-clicking
+// at a chosen position — no server-side mod required.
+int ModApiClient::l_send_interact(lua_State *L)
+{
+	// arg 1: action (u8 InteractAction enum value)
+	int action = (int)luaL_checkinteger(L, 1);
+	if (action < INTERACT_START_DIGGING || action > INTERACT_ACTIVATE) {
+		lua_pushboolean(L, false);
+		lua_pushliteral(L, "action out of range (0..5)");
+		return 2;
+	}
+
+	// arg 2: pointed_thing table
+	luaL_checktype(L, 2, LUA_TTABLE);
+
+	PointedThing pt;
+	pt.type = POINTEDTHING_NOTHING;
+	pt.pointability = PointabilityType::POINTABLE;
+
+	// Read type
+	lua_getfield(L, 2, "type");
+	std::string ptype;
+	if (lua_isstring(L, -1)) {
+		ptype = lua_tostring(L, -1);
+	} else {
+		ptype = "node";
+	}
+	lua_pop(L, 1);
+
+	if (ptype == "node") {
+		pt.type = POINTEDTHING_NODE;
+
+		lua_getfield(L, 2, "node_undersurface");
+		if (lua_istable(L, -1)) {
+			pt.node_undersurface = read_v3s16(L, lua_gettop(L));
+		} else {
+			lua_pop(L, 1);
+			lua_pushboolean(L, false);
+			lua_pushliteral(L, "pointed_thing.node_undersurface must be {x,y,z}");
+			return 2;
+		}
+		lua_pop(L, 1);
+
+		lua_getfield(L, 2, "node_abovesurface");
+		if (lua_istable(L, -1)) {
+			pt.node_abovesurface = read_v3s16(L, lua_gettop(L));
+		} else {
+			lua_pop(L, 1);
+			lua_pushboolean(L, false);
+			lua_pushliteral(L, "pointed_thing.node_abovesurface must be {x,y,z}");
+			return 2;
+		}
+		lua_pop(L, 1);
+
+		// node_real_undersurface defaults to node_undersurface if not given
+		pt.node_real_undersurface = pt.node_undersurface;
+		lua_getfield(L, 2, "node_real_undersurface");
+		if (lua_istable(L, -1))
+			pt.node_real_undersurface = read_v3s16(L, lua_gettop(L));
+		lua_pop(L, 1);
+	} else if (ptype == "object") {
+		pt.type = POINTEDTHING_OBJECT;
+		lua_getfield(L, 2, "object_id");
+		pt.object_id = (u16)luaL_optinteger(L, -1, 0);
+		lua_pop(L, 1);
+	} else if (ptype == "nothing" || ptype == "none" || ptype == "") {
+		pt.type = POINTEDTHING_NOTHING;
+	} else {
+		lua_pushboolean(L, false);
+		lua_pushliteral(L, "pointed_thing.type must be 'node' or 'object' or 'nothing'");
+		return 2;
+	}
+
+	// Discard if the client isn't in a state to send interactions.
+	Client *client = getClient(L);
+	if (!client) {
+		lua_pushboolean(L, false);
+		lua_pushliteral(L, "no client");
+		return 2;
+	}
+
+	// Hand off to the existing client path that already builds and sends
+	// TOSERVER_INTERACT for real player input. The server will validate it
+	// like any other right-click.
+	client->interact((InteractAction)action, pt);
+
+	lua_pushboolean(L, true);
+	return 1;
+}
