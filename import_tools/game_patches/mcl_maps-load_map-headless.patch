diff --git a/mods/ITEMS/mcl_maps/init.lua b/mods/ITEMS/mcl_maps/init.lua
index 4271c3c..e11017b 100644
--- a/mods/ITEMS/mcl_maps/init.lua
+++ b/mods/ITEMS/mcl_maps/init.lua
@@ -129,6 +129,25 @@ function mcl_maps.load_map(id, callback)
 					callback(texture)
 				end
 			end)
+			-- dynamic_add_media's callback only fires once a PLAYER has
+			-- received the media. With nobody connected (map import /
+			-- headless server) it never fires, and mcl_itemframes'
+			-- set_item "dirty recursive hack" then retries
+			-- update_entity EVERY step -- which spawns a NEW frame
+			-- display entity each time because find_entity cannot see
+			-- already-saved (static) objects. Observed damage: one
+			-- mapblock with 50 map frames ended up with 50,050
+			-- mcl_itemframes:item objects (museum import 2026-09-25,
+			-- near-crash + engine "suspiciously large amount of
+			-- objects" wipes). The texture file is on disk either way
+			-- and the callback only hands its name to the caller -- so
+			-- when no player exists to send it to, finish immediately.
+			if #core.get_connected_players() == 0 then
+				loaded_maps[id] = true
+				if callback then
+					callback(texture)
+				end
+			end
 		end
 	end
 
